{
  "name": "B&W Zebra",
  "description": "B&W 斑马纹版，白底封面，内容明细行白/浅灰交替，黑白打印视觉层次更清晰",
  "screen": true,
  "coverTemplate": "cover-bw.html",
  "pdfMargin": { "top": "0", "bottom": "0", "left": "0", "right": "0" },
  "css": {
    "--primary": "#0a0a0a",
    "--text-primary": "#0a0a0a",
    "--text-secondary": "#525252",
    "--text-muted": "#737373",
    "--bg-page": "#ffffff",
    "--bg-accent-light": "#e8e8e8",
    "--border-light": "#d0d0d0",
    "--border-accent": "#333333",
    "--accent-on": "#ffffff",
    "--page-bg": "#ffffff",
    "--cat-row-bg": "#e8e8e8",
    "--cat-num-size": "44px",
    "--cat-en-size": "11px",
    "--cat-zh-size": "15px",
    "--cat-row-py": "8px",
    "--remark-color": "#333333",
    "--table-style": "zebra",
    "--page-mode": "screen",
    "--num-font": "'JetBrains Mono', monospace",
    "--cover-bg": "#ffffff"
  },
  "pageCSS": "@page { size: A4; margin: 40px 0 40px 0; @bottom-center { content: counter(page); font-size: 10px; font-family: 'JetBrains Mono', monospace; color: #737373; letter-spacing: 0.14em; text-transform: uppercase; } }"
}
