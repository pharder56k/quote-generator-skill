{
  "name": "Swiss IKB",
  "description": "瑞士克莱因蓝屏幕阅读版，全页蓝底封面，双语分类标题，等宽数字字体",
  "screen": true,
  "pdfMargin": { "top": "0", "bottom": "0", "left": "0", "right": "0" },
  "css": {
    "--primary": "#002FA7",
    "--text-primary": "#0a0a0a",
    "--text-secondary": "#525252",
    "--text-muted": "#737373",
    "--bg-page": "#fafaf8",
    "--bg-accent-light": "#E8EEF8",
    "--border-light": "#e0e0e0",
    "--border-accent": "#002FA7",
    "--accent-on": "#ffffff",
    "--page-bg": "#fafaf8",
    "--cat-row-bg": "#E8EEF8",
    "--cat-num-size": "44px",
    "--cat-en-size": "11px",
    "--cat-zh-size": "15px",
    "--cat-row-py": "8px",
    "--remark-color": "#c53030",
    "--table-style": "swiss",
    "--page-mode": "screen",
    "--num-font": "'JetBrains Mono', monospace",
    "--cover-bg": "#002FA7"
  },
  "pageCSS": "@page { background: var(--cover-bg); }"
}
